{
  "info": {
    "name": "NexaPay ML Behaviour Tests",
    "description": "Direct local tests for customer-isolated ML behaviour history. These are ML service tests; use the app/API for end-to-end payment flow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8091"
    }
  ],
  "item": [
