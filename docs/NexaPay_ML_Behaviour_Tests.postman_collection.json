      "name": "0 - Seed successful login location",
      "description": "Successful logins from the actual login flow are also stored and participate in location-history checks.",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/feedback",
          "host": [
            "localhost"
          ],
          "port": "8091",
          "path": [
            "feedback"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer_id\": \"customer-A\",\n  \"event_type\": \"LOGIN\",\n  \"occurred_at\": \"2026-10-18T20:00:00Z\",\n  \"latitude\": 17.385,\n  \"longitude\": 78.4867,\n  \"city\": \"Hyderabad\",\n  \"device_id\": \"phone-a\",\n  \"outcome\": \"APPROVED\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
